class FlagSet(int):
    _known: ClassVar[int]
    @classmethod
    def all(cls) -> Self:
        """Return a set with every named flag."""
        ...
    @classmethod
    def empty(cls) -> Self:
        """Return a set with no flags."""
        ...
    @classmethod
    def from_bits(cls, bits: int) -> Optional[Self]:
        """Return the set for raw bits, or None if any bit is not a named flag.

        Args:
            bits: Raw flag bits.
        """
        ...
    @classmethod
    def from_bits_truncate(cls, bits: int) -> Self:
        """Return the set for raw bits, dropping bits that are not named flags.

        Args:
            bits: Raw flag bits.
        """
        ...
    def intersects(self, flags: Self) -> bool:
        """Return whether this set shares any flag with flags.

        Args:
            flags: Flags to test.
        """
        ...
    def is_all(self) -> bool:
        """Return whether every named flag is set."""
        ...
    def __contains__(self, flags: Self) -> bool: ...
    def __iter__(self) -> Iterator[Self]: ...
    def __or__(self, other: int) -> Self: ...
    def __ror__(self, other: int) -> Self: ...
    def __and__(self, other: int) -> Self: ...
    def __rand__(self, other: int) -> Self: ...
    def __xor__(self, other: int) -> Self: ...
    def __rxor__(self, other: int) -> Self: ...
    def __sub__(self, other: int) -> Self: ...
    def __rsub__(self, other: int) -> Self: ...
    def __invert__(self) -> Self: ...

