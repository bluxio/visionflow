"""Native cambc bindings. Use the cambc package instead."""

from typing import Any, ClassVar, Iterator, Optional, Union

from typing_extensions import Buffer, Self

class Vec2:
    """Unit vectors for the 8 standard directions; north is +y."""
    NORTH: ClassVar[Vec2]
    NORTH_EAST: ClassVar[Vec2]
    EAST: ClassVar[Vec2]
    SOUTH_EAST: ClassVar[Vec2]
    SOUTH: ClassVar[Vec2]
    SOUTH_WEST: ClassVar[Vec2]
    WEST: ClassVar[Vec2]
    NORTH_WEST: ClassVar[Vec2]
    @property
    def x(self) -> int:
        """Horizontal coordinate or displacement."""
        ...
    @property
    def y(self) -> int:
        """Vertical coordinate or displacement; +y is north."""
        ...
    def __init__(self, x: int, y: int) -> None: ...
    def __add__(self, other: Vec2) -> Vec2: ...
    def __sub__(self, other: Vec2) -> Vec2: ...
    def __mul__(self, n: int) -> Vec2: ...
    def __rmul__(self, n: int) -> Vec2: ...
    def __floordiv__(self, n: int) -> Vec2: ...
    def __neg__(self) -> Vec2: ...
    def __pos__(self) -> Vec2: ...
    def __hash__(self) -> int: ...
    def reflect_horizontal(self) -> Vec2:
        """Return this position reflected across the map horizontally, reversing x."""
        ...
    def reflect_vertical(self) -> Vec2:
        """Return this position reflected across the map vertically, reversing y."""
        ...
    def rotate_180(self) -> Vec2:
        """Return this position rotated 180 degrees within the map."""
        ...
    def rotate_cw(self) -> Vec2:
        """Return this direction rotated 45 degrees clockwise."""
        ...
    def rotate_ccw(self) -> Vec2:
        """Return this direction rotated 45 degrees counter-clockwise."""
        ...
    def dot(self, other: Vec2) -> int:
        """Return the dot product.

        Args:
            other: Other vector.
        """
        ...
    def cross(self, other: Vec2) -> int:
        """Return the signed 2D cross product.

        Args:
            other: Other vector.
        """
        ...
    def length_squared(self) -> int:
        """Return the squared Euclidean length."""
        ...
    def chebyshev_distance(self, other: Vec2) -> int:
        """Return the Chebyshev distance, the number of king moves between the tiles.

        Args:
            other: Other vector.
        """
        ...

class Bitboard:
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __invert__(self) -> Bitboard: ...
    def __and__(self, other: Bitboard) -> Bitboard: ...
    def __or__(self, other: Bitboard) -> Bitboard: ...
    def __xor__(self, other: Bitboard) -> Bitboard: ...
    def __iand__(self, other: Bitboard) -> Self: ...
    def __ior__(self, other: Bitboard) -> Self: ...
    def __ixor__(self, other: Bitboard) -> Self: ...
    def copy(self) -> Bitboard:
        """Return an independent copy."""
        ...
    def width(self) -> int:
        """Return the map width in tiles."""
        ...
    def height(self) -> int:
        """Return the map height in tiles."""
        ...
    @staticmethod
    def raw_buffer_size() -> int:
        """Return the size in bytes of the engine-chunked buffer."""
        ...
    @staticmethod
    def linear_buffer_size() -> int:
        """Return the size in bytes of the row-major buffer."""
        ...
    def is_set(self, position: Vec2) -> bool:
        """Return whether the tile is set; raises Error outside the map.

        Args:
            position: Tile to query.
        """
        ...
    def set(self, position: Vec2, value: bool = True) -> None:
        """Set or clear a tile; raises Error outside the map.

        Args:
            position: Tile to update.
            value: True to set the tile, False to clear it.
        """
        ...
    def toggle(self, position: Vec2) -> None:
        """Flip a tile; raises Error outside the map.

        Args:
            position: Tile to flip.
        """
        ...
    def clear(self) -> None:
        """Clear every tile."""
        ...
    def fill(self) -> None:
        """Set every tile on the map."""
        ...
    def is_empty(self) -> bool:
        """Return whether no tile is set."""
        ...
    def count(self) -> int:
        """Return the number of set tiles."""
        ...
    def positions(self) -> list[Vec2]:
        """Return the set tiles in row-major order."""
        ...
    def print(self) -> None:
        """Print this board to stdout for debugging."""
        ...
    def import_raw_buffer(self, data: Buffer) -> None:
        """Replace the contents from an engine-chunked buffer.

        Args:
            data: Bytes-like object exactly raw_buffer_size() long.
        """
        ...
    def export_raw_buffer(self) -> bytes:
        """Return the contents as an engine-chunked buffer."""
        ...
    def export_raw_buffer_into(self, out: Buffer) -> None:
        """Write the contents as an engine-chunked buffer.

        Args:
            out: Writable bytes-like object exactly raw_buffer_size() long.
        """
        ...
    def import_linear_buffer(self, data: Buffer) -> None:
        """Replace the contents from a row-major buffer with one value per tile.

        Args:
            data: Bytes-like object exactly linear_buffer_size() long.
        """
        ...
    def export_linear_buffer(self) -> bytes:
        """Return the contents as a row-major buffer with one value per tile."""
        ...
    def export_linear_buffer_into(self, out: Buffer) -> None:
        """Write the contents as a row-major buffer with one value per tile.

        Args:
            out: Writable bytes-like object exactly linear_buffer_size() long.
        """
        ...
    def shift_right(self, count: int) -> Bitboard:
        """Return a copy shifted horizontally; tiles shifted off the map are dropped.

        Args:
            count: Columns to shift; negative values shift left.
        """
        ...
    def shift_up(self, count: int) -> Bitboard:
        """Return a copy shifted vertically; tiles shifted off the map are dropped.

        Args:
            count: Rows to shift; negative values shift down.
        """
        ...
    def reflect(self, symmetry: int) -> Bitboard:
        """Return a copy transformed by a map symmetry.

        Args:
            symmetry: Map symmetry to apply.
        """
        ...
    def reflect_horizontal(self) -> Bitboard:
        """Return a copy reflected across the map horizontally, reversing x."""
        ...
    def reflect_vertical(self) -> Bitboard:
        """Return a copy reflected across the map vertically, reversing y."""
        ...
    def rotate_180(self) -> Bitboard:
        """Return a copy rotated 180 degrees within the map."""
        ...
    def draw_circle(self, center: Vec2, radius: float) -> None:
        """Set every tile within a Euclidean radius of a centre tile.

        Args:
            center: Centre tile.
            radius: Euclidean radius in tiles.
        """
        ...
    def draw_chebyshev(self, center: Vec2, radius: float) -> None:
        """Set every tile within a Chebyshev radius of a centre tile.

        Args:
            center: Centre tile.
            radius: Chebyshev radius in tiles.
        """
        ...
    def reachable_tiles(
        self, origin: Vec2, distance: int, frontier: Optional[Bitboard] = None, scratch: Optional[Bitboard] = None
    ) -> Bitboard:
        """Return the tiles reachable from origin, treating this board as walls.

        Args:
            origin: Start tile.
            distance: Maximum number of 8-directional steps from origin.
            frontier: Optional working Bitboard; its contents are overwritten.
            scratch: Optional working Bitboard; its contents are overwritten.
        """
        ...
    def shadow_cast(self, origin: Vec2, distance: int) -> Bitboard:
        """Return the tiles visible from origin, treating this board as opaque walls.

        Args:
            origin: Viewer tile.
            distance: Maximum sight radius in tiles.
        """
        ...
    def shift_right_into(self, count: int, out: Bitboard) -> None:
        """Like shift_right, but writes into out.

        Args:
            count: Columns to shift; negative values shift left.
            out: Destination; its previous contents are overwritten.
        """
        ...
    def shift_up_into(self, count: int, out: Bitboard) -> None:
        """Like shift_up, but writes into out.

        Args:
            count: Rows to shift; negative values shift down.
            out: Destination; its previous contents are overwritten.
        """
        ...
    def reflect_into(self, symmetry: int, out: Bitboard) -> None:
        """Like reflect, but writes into out.

        Args:
            symmetry: Map symmetry to apply.
            out: Destination; its previous contents are overwritten.
        """
        ...
    def reflect_horizontal_into(self, out: Bitboard) -> None:
        """Like reflect_horizontal, but writes into out.

        Args:
            out: Destination; its previous contents are overwritten.
        """
        ...
    def reflect_vertical_into(self, out: Bitboard) -> None:
        """Like reflect_vertical, but writes into out.

        Args:
            out: Destination; its previous contents are overwritten.
        """
        ...
    def rotate_180_into(self, out: Bitboard) -> None:
        """Like rotate_180, but writes into out.

        Args:
            out: Destination; its previous contents are overwritten.
        """
        ...
    def reachable_tiles_into(
        self, origin: Vec2, distance: int, out: Bitboard, frontier: Optional[Bitboard] = None, scratch: Optional[Bitboard] = None
    ) -> None:
        """Like reachable_tiles, but writes into out.

        Args:
            origin: Start tile.
            distance: Maximum number of 8-directional steps from origin.
            out: Destination; its previous contents are overwritten.
            frontier: Optional working Bitboard; its contents are overwritten.
            scratch: Optional working Bitboard; its contents are overwritten.
        """
        ...
    def shadow_cast_into(self, origin: Vec2, distance: int, out: Bitboard) -> None:
        """Like shadow_cast, but writes into out.

        Args:
            origin: Viewer tile.
            distance: Maximum sight radius in tiles.
            out: Destination; its previous contents are overwritten.
        """
        ...

class DistanceField:
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def copy(self) -> DistanceField:
        """Return an independent copy."""
        ...
    def width(self) -> int:
        """Return the map width in tiles."""
        ...
    def height(self) -> int:
        """Return the map height in tiles."""
        ...
    @staticmethod
    def raw_buffer_size() -> int:
        """Return the size in bytes of the engine-chunked buffer."""
        ...
    @staticmethod
    def linear_buffer_size() -> int:
        """Return the size in bytes of the row-major buffer."""
        ...
    def get(self, position: Vec2) -> int:
        """Return the distance stored at a tile; raises Error outside the map.

        Args:
            position: Tile to query.
        """
        ...
    def set(self, position: Vec2, value: int) -> None:
        """Store a distance at a tile; raises Error outside the map.

        Args:
            position: Tile to update.
            value: Distance to store.
        """
        ...
    def next_move_from(self, position: Vec2) -> Optional[Vec2]:
        """Return the first optimal step towards a root as a direction delta, or None at a root or unreached tile.

        Args:
            position: Tile to step from.
        """
        ...
    def next_moves_from(self, position: Vec2) -> list[Vec2]:
        """Return every optimal step towards a root as direction deltas, in compass order from north.

        Args:
            position: Tile to step from.
        """
        ...
    def print(self) -> None:
        """Print this board to stdout for debugging."""
        ...
    def import_raw_buffer(self, data: Buffer) -> None:
        """Replace the contents from an engine-chunked buffer.

        Args:
            data: Bytes-like object exactly raw_buffer_size() long.
        """
        ...
    def export_raw_buffer(self) -> bytes:
        """Return the contents as an engine-chunked buffer."""
        ...
    def export_raw_buffer_into(self, out: Buffer) -> None:
        """Write the contents as an engine-chunked buffer.

        Args:
            out: Writable bytes-like object exactly raw_buffer_size() long.
        """
        ...
    def import_linear_buffer(self, data: Buffer) -> None:
        """Replace the contents from a row-major buffer with one value per tile.

        Args:
            data: Bytes-like object exactly linear_buffer_size() long.
        """
        ...
    def export_linear_buffer(self) -> bytes:
        """Return the contents as a row-major buffer with one value per tile."""
        ...
    def export_linear_buffer_into(self, out: Buffer) -> None:
        """Write the contents as a row-major buffer with one value per tile.

        Args:
            out: Writable bytes-like object exactly linear_buffer_size() long.
        """
        ...
    def compute(self, walls: Bitboard, roots: Bitboard, visited: Bitboard, max_distance: int = ...) -> None:
        """Compute distances from roots around walls into this field.

        Args:
            walls: Impassable tiles.
            roots: Tiles at distance zero.
            visited: Receives the tiles the search reached.
            max_distance: Tiles farther than this are left unreached.
        """
        ...
    def compute_with_expansion_count(
        self, walls: Bitboard, roots: Bitboard, visited: Bitboard, max_distance: int = ...
    ) -> int:
        """Like compute, but return the number of tiles the search expanded.

        Args:
            walls: Impassable tiles.
            roots: Tiles at distance zero.
            visited: Receives the tiles the search reached.
            max_distance: Tiles farther than this are left unreached.
        """
        ...
    def compute_to(
        self, walls: Bitboard, roots: Bitboard, destinations: Bitboard, visited: Bitboard, max_distance: int = ...
    ) -> None:
        """Compute distances from roots until destinations are reached or the search is exhausted.

        Args:
            walls: Impassable tiles.
            roots: Tiles at distance zero.
            destinations: The search stops once these tiles are reached.
            visited: Receives the tiles the search reached.
            max_distance: Tiles farther than this are left unreached.
        """
        ...
    def compute_to_with_expansion_count(
        self, walls: Bitboard, roots: Bitboard, destinations: Bitboard, visited: Bitboard, max_distance: int = ...
    ) -> int:
        """Like compute_to, but return the number of tiles the search expanded.

        Args:
            walls: Impassable tiles.
            roots: Tiles at distance zero.
            destinations: The search stops once these tiles are reached.
            visited: Receives the tiles the search reached.
            max_distance: Tiles farther than this are left unreached.
        """
        ...

